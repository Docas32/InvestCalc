<?xml version="1.0" encoding="utf-8"?>
<!-- Defaults do Firebase Remote Config (T1/P4), aplicadas via
     setDefaultsAsync(R.xml.remote_config_defaults) no cold start. Estes
     valores valem até o primeiro fetch/activate do Firebase. -->
<defaultsMap>
    <entry>
        <key>ads_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>interstitial_frequency</key>
        <value>4</value>
    </entry>
    <entry>
        <key>fallback_di_aa</key>
        <value>13.90</value>
    </entry>
    <entry>
        <key>fallback_selic_aa</key>
        <value>13.90</value>
    </entry>
    <entry>
        <key>fallback_ipca_aa</key>
        <value>4.50</value>
    </entry>
</defaultsMap>