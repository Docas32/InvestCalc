<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do adaptive icon (P7.3, paleta WhatsApp): gradiente linear 135°
     de #25D366 (canto superior-esquerdo) para #075E54 (canto
     inferior-direito). A máscara do launcher recorta sobre ele. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#25D366"
                android:endColor="#075E54" />
        </aapt:attr>
    </path>
</vector>